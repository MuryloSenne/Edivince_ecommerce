EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_CUSTOMER_CONFIRMATION=true

# E-mail dos pedidos — opção 2: Resend (basta a API key e um EMAIL_FROM verificado)
RESEND_API_KEY=
